APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb

# Reverb (WebSocket push for live monitoring). Generate your own id/key/secret.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Signed monitoring webhook (empty = disabled): hex HMAC-SHA256 of the raw body.
ASTERISK_WEBHOOK_SECRET=
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

ASTERISK_DB_CONNECTION=asterisk
# ASTERISK_DB_HOST=127.0.0.1
# ASTERISK_DB_PORT=5432
# ASTERISK_DB_DATABASE=asterisk
# ASTERISK_DB_USERNAME=asterisk
# ASTERISK_DB_PASSWORD=
ASTERISK_AMI_HOST=127.0.0.1
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USERNAME=callcenter
ASTERISK_AMI_SECRET=change-me
ASTERISK_MONITOR_CONTEXT=supervisor-monitor
ASTERISK_MONITOR_EXTENSION=spy
ASTERISK_MONITOR_CALLER_ID="Supervisor Monitor"
ASTERISK_AMI_ORIGINATE_TIMEOUT=30000
ASTERISK_AMI_SOCKET=/run/callcenter/asterisk-ami.sock
ASTERISK_AMI_IPC_TIMEOUT=5
ASTERISK_AMI_SNAPSHOT_INTERVAL=2

# PJSIP endpoints created by the app (context is always the team context)
ASTERISK_PJSIP_TRANSPORT=transport-wss
ASTERISK_PJSIP_ALLOW=opus,ulaw,alaw
ASTERISK_PJSIP_MAX_CONTACTS=1

# Browser softphone
ASTERISK_SIP_DOMAIN=
ASTERISK_SIP_WS_URL=
ASTERISK_STUN_URL=
ASTERISK_TURN_URL=
ASTERISK_TURN_USERNAME=
ASTERISK_TURN_CREDENTIAL=

# Queue presence heartbeat (seconds)
ASTERISK_PRESENCE_HEARTBEAT=60
ASTERISK_PRESENCE_STALE_AFTER=180

# Team dialplan (t_{asterisk_key})
ASTERISK_CLOSED_SOUND=callcenter-closed
ASTERISK_DIAL_TIMEOUT=30
ASTERISK_REALTIME_EXTENSIONS_FAMILY=extensions

CONTACT_EMAIL=

# Subscriptions: payment provider (paydunya | cinetpay). See deploy/README.md.
BILLING_GATEWAY=paydunya
PAYDUNYA_MODE=test
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_CHANNELS=

# CinetPay (not open to Malian merchants; Senegal / Côte d'Ivoire)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
CINETPAY_CHANNELS=ALL
BILLING_TRIAL_DAYS=14

# Video meetings (self-hosted LiveKit). See deploy/livekit.yaml.
LIVEKIT_URL=
LIVEKIT_API_URL=http://127.0.0.1:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_RECORDING_ENABLED=false
LIVEKIT_RECORDING_PATH=/recordings/{room_name}-{time}.mp4

# Outbound campaigns (php artisan campaigns:dial). See deploy/README.md.
BILLING_TRIAL_PLAN=essentiel
ASTERISK_NUMBERS_AUTO_ASSIGN=true
ASTERISK_CAMPAIGN_TRUNK=
ASTERISK_CAMPAIGN_DIAL_PREFIX=00
ASTERISK_CAMPAIGN_COUNTRY_CODE=223
ASTERISK_CAMPAIGN_NATIONAL_LENGTH=8

# Inbound routing (DIDs land in this context; set it on the provider trunk).
ASTERISK_INBOUND_CONTEXT=cc-inbound
ASTERISK_SOUND_CALLBACK_OFFER=callcenter-callback-offer
ASTERISK_SOUND_CALLBACK_CONFIRM=callcenter-callback-confirm
ASTERISK_SOUND_SURVEY=callcenter-survey
ASTERISK_SOUND_SURVEY_THANKS=callcenter-survey-thanks
ASTERISK_SOUND_RECORDING_NOTICE=callcenter-recording-notice

# Call recording (Pro / Entreprise): token shared with deploy/asterisk/cc-recording-upload
ASTERISK_RECORDING_TOKEN=
ASTERISK_RECORDING_DISK=local
ASTERISK_RECORDING_DIR=/var/spool/asterisk/monitor/callcenter
ASTERISK_RECORDING_COMMAND=/usr/local/bin/cc-recording-upload

# Legal pages (/confidentialite, /mentions-legales, /confiance) — empty = « [à compléter] »
LEGAL_COMPANY_NAME=MbayeLab
LEGAL_COMPANY_FORM=
LEGAL_COMPANY_CAPITAL=
LEGAL_COMPANY_ADDRESS="Moribabougou, Bamako, Mali"
LEGAL_RCCM=
LEGAL_NIF=
LEGAL_PHONE=
LEGAL_EMAIL=
LEGAL_PUBLICATION_DIRECTOR=
LEGAL_APDP_REFERENCE=
PRIVACY_EMAIL=
SECURITY_EMAIL=
LEGAL_HOST_NAME=SMTD
LEGAL_HOST_ADDRESS="Bamako, Mali"
LEGAL_EMAIL_PROVIDER=
LEGAL_EMAIL_PROVIDER_COUNTRY=
